<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：青→蓝渐变的圆角播放三角，一道白色波浪从中穿过，下面再压一道蓝色波浪。
     内容收在自适应图标的 72dp 安全区里（18～90），圆形 / 方圆形遮罩都不会切到。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 播放三角：填充 + 同色粗描边（圆角连接）得到圆润的角。 -->
    <path
        android:pathData="M35,29 L79,53 L35,79 Z"
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35"
                android:startY="29"
                android:endX="79"
                android:endY="79"
                android:startColor="#FF3EE3CB"
                android:endColor="#FF2A7BF6" />
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="35"
                android:startY="29"
                android:endX="79"
                android:endY="79"
                android:startColor="#FF3EE3CB"
                android:endColor="#FF2A7BF6" />
        </aapt:attr>
    </path>

    <!-- 白色波浪：把三角下部切出一道缺口。 -->
    <path
        android:pathData="M20,67 C33,55 47,57 57,64 C67,71 78,72 88,61"
        android:strokeColor="#FFF7FAFD"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 蓝色波浪：从左下扫到右侧，青→蓝渐变。 -->
    <path
        android:pathData="M15,77 C29,61 46,62 57,71 C68,80 80,82 90,67"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="15"
                android:startY="77"
                android:endX="90"
                android:endY="67"
                android:startColor="#FF3EE3CB"
                android:endColor="#FF2A7BF6" />
        </aapt:attr>
    </path>
</vector>
