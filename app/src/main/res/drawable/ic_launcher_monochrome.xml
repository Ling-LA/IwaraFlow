<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 的主题图标（monochrome）：系统按壁纸取色，只认形状不认颜色，
  所以这里是纯单色的播放三角 + 波浪，画在自适应图标的安全区（中心直径 66 的圆）里。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 播放三角，圆角，重心落在画布中央偏上。 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,34.5c0,-2.6 2.8,-4.2 5,-2.9l27.5,17.4c2,1.3 2,4.3 0,5.6L50,72c-2.2,1.3 -5,-0.3 -5,-2.9z" />

    <!-- 底下的波浪：两笔圆头短线，和启动图标上的波纹呼应。 -->
    <path
        android:pathData="M34,80c4,-5 8,-5 12,0s8,5 12,0 8,-5 12,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
