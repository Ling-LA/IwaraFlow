<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF8FE">

    <LinearLayout
        android:id="@+id/savedListPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DDF1FC"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/savedBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="‹  返回"
                android:textColor="#285C7B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/savedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#17324A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/savedSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#607D93"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/savedVideos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="18dp" />
    </LinearLayout>

    <!-- 竖滑播放页：和作者作品页一样，上滑是列表里的下一条，到底有提示。 -->
    <FrameLayout
        android:id="@+id/savedFeedPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/savedPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/savedFeedBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:background="#66000000"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="‹ 返回列表"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/commentsScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <include layout="@layout/view_comments_panel" />
    </FrameLayout>
</FrameLayout>
