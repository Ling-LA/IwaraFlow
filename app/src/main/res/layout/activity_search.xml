<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/searchListPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_header"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/searchBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="‹  返回"
                android:textColor="@color/page_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="搜索"
                android:textColor="@color/page_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="视频名 / 标签 / 作者名"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/page_text"
                    android:textColorHint="#99607D93"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/searchSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="搜索"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabVideos"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="视频名"
                    android:textColor="@color/page_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabTags"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="标签"
                    android:textColor="@color/page_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tabAuthors"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="作者名"
                    android:textColor="@color/page_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 排序入口：视频名 / 标签两栏才有，作者名固定按关注数排。 -->
            <HorizontalScrollView
                android:id="@+id/searchSortRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/sortDate"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_sort_chip"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:text="上传时间"
                        android:textColor="@color/page_accent"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/sortViews"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_sort_chip"
                        android:gravity="center"
                        android:minWidth="52dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:text="播放量"
                        android:textColor="@color/page_accent"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/sortLikes"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_sort_chip"
                        android:gravity="center"
                        android:minWidth="52dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:text="点赞数"
                        android:textColor="@color/page_accent"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/searchMatchOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_sort_chip"
                        android:gravity="center"
                        android:minWidth="76dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:text="调整匹配词"
                        android:textColor="@color/page_accent"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/sortOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_sort_chip"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:text="倒序 ↓"
                        android:textColor="@color/page_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/searchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp"
            android:textColor="@color/page_secondary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="18dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/searchFeedPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/searchPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/searchFeedBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:background="#66000000"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="‹ 搜索结果"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 评论面板开着时盖住画面：点画面收起面板。 -->
        <View
            android:id="@+id/commentsScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <include layout="@layout/view_comments_panel" />
    </FrameLayout>
</FrameLayout>
