<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_author_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="72dp"
        android:background="#E5F3FC">

        <TextView
            android:id="@+id/videoIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶"
            android:textColor="#4F8DB7"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/playbackIssue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC17324A"
            android:gravity="center"
            android:padding="7dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#17324A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/videoMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#5E7B91"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/videoTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8299AA"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
