<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_author_card"
    android:gravity="center_vertical"
    android:minHeight="78dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/followingAvatar"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="#E5F3FC"
        android:contentDescription="作者头像"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/followingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#17324A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/followingUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#5E7B91"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/followingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="已关注"
            android:textColor="#8299AA"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="›"
        android:textColor="#7CA6C2"
        android:textSize="26sp" />
</LinearLayout>
