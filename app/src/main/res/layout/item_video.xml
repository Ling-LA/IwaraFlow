<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- 暂停时的控制行：后退 N 秒 / 播放三角 / 前进 N 秒。左下角、进度条上方，
         位置由 PauseSeekBar 在运行时算出来（跟着进度条走）。 -->
    <LinearLayout
        android:id="@+id/pauseControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_pause_controls"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <!-- 后退：圆弧箭头，秒数写在圆心。 -->
        <FrameLayout
            android:id="@+id/skipBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="后退"
                android:src="@drawable/ic_skip_back" />

            <TextView
                android:id="@+id/skipBackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="15"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>

        <com.ling.iwaraflow.PauseIndicatorView
            android:id="@+id/pauseIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ic_play"
            android:contentDescription="继续播放"
            android:text=""
            android:visibility="gone" />

        <!-- 前进：顺时针圆弧箭头，秒数写在圆心。 -->
        <FrameLayout
            android:id="@+id/skipForward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="前进"
                android:src="@drawable/ic_skip_forward" />

            <TextView
                android:id="@+id/skipForwardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="15"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/speedIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="74dp"
        android:background="#B3000000"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:text="2× 加速中"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="88dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/author"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:onClick="openAuthorProfile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.ling.iwaraflow.AuthorFollowButton
                android:id="@+id/authorFollow"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:minWidth="62dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- 每个按钮都是 wrap_content，彼此之间统一 14dp 间距；图标和文字之间只留 3dp。
             爱心 / 五角星图标 32dp，盒子 36dp（2dp 内边距），这样它们和别的按钮之间
             看上去的间距才和别处一样。 -->
        <ImageView
            android:id="@+id/like"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:contentDescription="点赞"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_rounded_outline" />

        <TextView
            android:id="@+id/likeCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/favorite"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:contentDescription="收藏"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_rounded_outline" />

        <!-- 官方评论：打开底部半屏面板，视频缩到面板上方接着播。 -->
        <TextView
            android:id="@+id/comments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableTop="@drawable/ic_comment"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="评论"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="画质\n最高"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableTop="@drawable/ic_download"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="下载"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableTop="@drawable/ic_pip"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="小窗"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableTop="@drawable/ic_share"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="分享"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.ling.iwaraflow.PauseSeekBar
        android:id="@+id/pauseSeekBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- 排在最后：动画要盖在操作栏上面，否则在按钮位置播就被按钮挡住了。
         它不可点击，触摸事件照常穿过去。 -->
    <com.ling.iwaraflow.ReactionBurstView
        android:id="@+id/reactionBurst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
