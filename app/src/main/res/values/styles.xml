<resources>
    <style name="Theme.IwaraFlow" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:colorAccent">#FF5C85</item>
        <item name="colorAccent">#FF5C85</item>
        <item name="alertDialogTheme">@style/Theme.IwaraFlow.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
    </style>

    <style name="Theme.IwaraFlow.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:colorAccent">#FF5C85</item>
        <item name="colorAccent">#FF5C85</item>
        <item name="android:textColorPrimary">#17324A</item>
        <item name="android:textColorSecondary">#607D93</item>
        <item name="buttonBarPositiveButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/IwaraFlow.DialogButton.Text</item>
    </style>

    <!-- All AlertDialog actions intentionally use one identical text-button style.
         This avoids OEMs hiding the positive action background while leaving white text. -->
    <style name="IwaraFlow.DialogButton.Text" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#D84B73</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
