<resources>
    <style name="Theme.IwaraFlow" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:colorAccent">#FF5C85</item>
        <item name="colorAccent">#FF5C85</item>
        <item name="buttonBarPositiveButtonStyle">@style/IwaraFlow.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/IwaraFlow.DialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/IwaraFlow.DialogButton.Negative</item>
    </style>

    <!--
        Do not rely on per-device AlertDialog button tinting here.  Some OEM themes
        keep AppCompat dialog buttons borderless even after backgroundTint is set,
        which made Login/Save look completely transparent.  These styles force a
        real rounded background at the theme level for every primary dialog action.
    -->
    <style name="IwaraFlow.DialogButton.Positive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_dialog_primary_button</item>
        <item name="android:backgroundTint">#FF5C85</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="IwaraFlow.DialogButton.Negative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FF5C85</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
