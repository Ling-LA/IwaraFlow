<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials, account-scoped interests and local diagnostics never enter OS backups. Use explicit data export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="iwara_flow_secure_session.xml" />
        <exclude domain="sharedpref" path="iwara_flow_session_fallback.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="navigation-lifecycle.txt" />
        <exclude domain="file" path="last-navigation-crash.txt" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="interest_metadata.xml" />
        <exclude domain="sharedpref" path="upload_draft.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="iwara_flow_secure_session.xml" />
        <exclude domain="sharedpref" path="iwara_flow_session_fallback.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="navigation-lifecycle.txt" />
        <exclude domain="file" path="last-navigation-crash.txt" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="interest_metadata.xml" />
        <exclude domain="sharedpref" path="upload_draft.xml" />
    </device-transfer>
</data-extraction-rules>
